# ============================================================================
#  SURPLUS STORE - Environment variables (copy to .env and fill in values)
# ============================================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- Database (MongoDB) ----------
MONGODB_URI=mongodb://127.0.0.1:27017/surplus_store

# ---------- Auth / JWT ----------
# Use long random strings, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---------- OTP / SMS ----------
# Supported providers: console | msg91 | twilio | firebase
OTP_PROVIDER=console
# console provider prints the OTP to the server log (DEV ONLY - never use in prod)
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SURPLS
MSG91_TEMPLATE_ID=
# Firebase Phone Auth (verify client-side idToken server side)
FIREBASE_PROJECT_ID=

# OTP rules
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Currency (INR by default)
CURRENCY=INR

# ---------- Order notifications (SMS/Email after successful payment) ----------
NOTIFY_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Surplus Store <no-reply@surplusstore.in>"

# ---------- Image uploads ----------
# Use "cloudinary" or "local" (local stores files in server/uploads)
UPLOAD_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Commerce settings ----------
FREE_SHIPPING_ABOVE=999
SHIPPING_FEE=79
COD_FEE=0

# ---------- Seed admin (created by `npm run seed`) ----------
ADMIN_MOBILE=9999999999
ADMIN_NAME=Store Admin
